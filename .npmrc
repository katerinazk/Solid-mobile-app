# Το npm εγκαθιστά μόνο του τα peer dependencies, διαλέγοντας πάντα την τελευταία έκδοση.
# Σε έργο Expo αυτό σπάει το native build: τραβάει πακέτα από επόμενο SDK (π.χ. expo-font 57
# δίπλα σε expo-modules-core 3.0.x) και η εφαρμογή κρασάρει στο ξεκίνημα με NoSuchMethodError.
# Οι εκδόσεις καθορίζονται από το ίδιο το Expo SDK, μέσω "npx expo install".
legacy-peer-deps=true
